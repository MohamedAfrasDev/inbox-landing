# Copy to .env.local and fill in. See docs/google-sheets.md for the setup.
# Without these, development logs sign-ups to the console instead of saving them;
# production refuses sign-ups until they are set.

# The "Web app" URL you get after deploying the Apps Script
SHEETS_WEBHOOK_URL=
# Any long random string; it must match the TOKEN script property in Apps Script
SHEETS_WEBHOOK_TOKEN=