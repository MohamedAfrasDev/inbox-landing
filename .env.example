# Copy to .env.local and fill in. Without these, development logs emails to the
# console instead of sending them; production refuses sign-ups until they are set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on outgoing mail, e.g. "Inbox <hello@yourdomain.com>"
MAIL_FROM=
# Where each new sign-up is reported
WAITLIST_NOTIFY_EMAIL=
